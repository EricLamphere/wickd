{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wickd",
  "version": "1.3.5",
  "identifier": "com.lampherelabs.wickd",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wickd",
        "url": "about:blank",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["binaries/frontend_dist/**/*"],
    "macOS": {
      "exceptionDomain": "127.0.0.1",
      "files": {
        "Resources/binaries/wickd-backend": "./binaries/wickd-backend",
        "Resources/binaries/llama": "./binaries/llama"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNTgwRkM2RDBEM0FBNEYKUldSUHF0UFF4ZzlZNFJWTVRuc2Vuc28xVTM2WlROMDY2SnhmRGdTZndsTHZxYkg1TlNRWnB6Sm4K",
      "endpoints": [
        "https://github.com/EricLamphere/wickd/releases/latest/download/latest.json"
      ]
    }
  }
}
