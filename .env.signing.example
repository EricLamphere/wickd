# Copy to .env.signing (gitignored) and fill in. Read by `task release`.
# Signing identity exactly as listed by: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
# Apple Account email used for notarization
APPLE_ID="you@example.com"
# App-specific password from https://account.apple.com → Sign-In and Security → App-Specific Passwords
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# 10-character Team ID from https://developer.apple.com/account → Membership details
APPLE_TEAM_ID="TEAMID1234"
