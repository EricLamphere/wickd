{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wickd",
  "version": "1.0.0",
  "identifier": "com.lampherelabs.wickd",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wickd",
        "url": "http://127.0.0.1:8001",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["binaries/frontend_dist/**/*"],
    "macOS": {
      "exceptionDomain": "127.0.0.1",
      "files": {
        "Resources/binaries/wickd-backend": "./binaries/wickd-backend",
        "Resources/binaries/llama": "./binaries/llama"
      }
    }
  }
}
